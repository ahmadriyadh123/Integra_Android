APP_ENV=production

# Dedicated connection settings for the school tenant registry only.
REGISTRY_DB_HOST=127.0.0.1
REGISTRY_DB_PORT=5432
REGISTRY_DB_NAME=middleware_registry
REGISTRY_DB_USER=middleware_registry_user
REGISTRY_DB_PASSWORD=replace-with-registry-password
ODOO_FILESTORE_PATH=

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=1

# Comma-separated browser origins, including the school admin web app when hosted separately.
CORS_ALLOW_ORIGINS=https://app.example.com,https://school-admin.example.com
