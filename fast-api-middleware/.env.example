APP_ENV=production

ODOO_FILESTORE_PATH=

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=1

# Bootstrap only: used once to create the first database admin. Password is stored hashed.
SCHOOL_ADMIN_USERNAME=admin
SCHOOL_ADMIN_PASSWORD=replace-with-a-long-random-password

# Comma-separated browser origins, including the school admin web app when hosted separately.
CORS_ALLOW_ORIGINS=https://app.example.com,https://school-admin.example.com