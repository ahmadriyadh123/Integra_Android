<odoo>
    <record id="view_school_tenant_tree" model="ir.ui.view">
        <field name="name">school.tenant.tree</field>
        <field name="model">school.tenant</field>
        <field name="arch" type="xml">
            <list string="Sekolah" sample="1">
                <field name="school_code"/>
                <field name="school_name"/>
                <field name="odoo_url" widget="url"/>
                <field name="odoo_db"/>
                <field name="active"/>
                <field name="registry_sync_status"/>
                <button name="action_check_connection"
                        type="object"
                        string="Periksa koneksi"
                        icon="fa-plug"/>
                    <button name="action_sync_registry"
                        type="object"
                        string="Sinkronkan registry"
                        class="oe_highlight"
                        icon="fa-refresh"/>
            </list>
        </field>
    </record>

    <record id="view_school_tenant_form" model="ir.ui.view">
        <field name="name">school.tenant.form</field>
        <field name="model">school.tenant</field>
        <field name="arch" type="xml">
            <form string="Sekolah">
                <header>
                    <button name="action_check_connection"
                            type="object"
                            string="Periksa koneksi Odoo"
                            class="oe_highlight"
                            icon="fa-plug"/>
                    <button name="action_sync_registry"
                            type="object"
                            string="Sinkronkan registry"
                            icon="fa-refresh"/>
                    <field name="active" widget="boolean_button"
                           options="{'terminology': 'archive'}"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Daftar sekolah pada aplikasi mobile tetap membaca
                        database registry middleware (<code>school_tenants</code>).
                        Data pada addon ini adalah representasi lokal yang
                        menggunakan kontrak field yang sama.
                    </div>
                    <div class="oe_title">
                        <label for="school_name"/>
                        <h1><field name="school_name" placeholder="Nama sekolah"/></h1>
                    </div>
                    <group>
                        <group string="Identitas sekolah">
                            <field name="school_code"/>
                        </group>
                        <group string="Koneksi Odoo">
                            <field name="odoo_url" widget="url"/>
                            <field name="odoo_db"/>
                            <field name="odoo_db_host"/>
                            <field name="odoo_db_port"/>
                            <field name="user_db"/>
                            <field name="secret_ref_db"/>
                        </group>
                    </group>
                    <group string="Status registry">
                        <field name="registry_id"/>
                        <field name="registry_sync_status"/>
                        <field name="registry_synced_at"/>
                        <field name="registry_sync_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_tenant_search" model="ir.ui.view">
        <field name="name">school.tenant.search</field>
        <field name="model">school.tenant</field>
        <field name="arch" type="xml">
            <search string="Cari sekolah">
                <field name="school_code"/>
                <field name="school_name"/>
                <field name="odoo_db"/>
                <filter name="active" string="Aktif"
                        domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Diarsipkan"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_school_tenant" model="ir.actions.act_window">
        <field name="name">Daftar sekolah</field>
        <field name="res_model">school.tenant</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_tenant_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_school_admin_root"
              name="School Admin"
              sequence="35"
              web_icon="base,static/description/modules.png"
              groups="base.group_system"/>

    <menuitem id="menu_school_tenant"
              name="Daftar sekolah"
              parent="menu_school_admin_root"
              action="action_school_tenant"
              sequence="10"
              groups="base.group_system"/>
</odoo>