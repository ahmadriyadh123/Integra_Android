<odoo>
    <record id="view_integra_school_tenant_tree" model="ir.ui.view">
        <field name="name">integra.school.tenant.tree</field>
        <field name="model">integra.school.tenant</field>
        <field name="arch" type="xml">
            <tree string="Sekolah" sample="1">
                <field name="school_code"/>
                <field name="school_name"/>
                <field name="odoo_url" widget="url"/>
                <field name="odoo_db"/>
                <field name="active"/>
                <button name="action_check_connection"
                        type="object"
                        string="Periksa koneksi"
                        icon="fa-plug"/>
            </tree>
        </field>
    </record>

    <record id="view_integra_school_tenant_form" model="ir.ui.view">
        <field name="name">integra.school.tenant.form</field>
        <field name="model">integra.school.tenant</field>
        <field name="arch" type="xml">
            <form string="Sekolah">
                <header>
                    <button name="action_check_connection"
                            type="object"
                            string="Periksa koneksi Odoo"
                            class="oe_highlight"
                            icon="fa-plug"/>
                    <field name="active" widget="boolean_button"
                           options="{'terminology': 'archive'}"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Daftar sekolah pada aplikasi mobile tetap membaca
                        database registry middleware (<code>school_tenants</code>).
                        Data pada addon ini adalah representasi lokal yang
                        menggunakan kontrak field yang sama.
                    </div>
                    <div class="oe_title">
                        <label for="school_name"/>
                        <h1><field name="school_name" placeholder="Nama sekolah"/></h1>
                    </div>
                    <group>
                        <group string="Identitas sekolah">
                            <field name="school_code"/>
                        </group>
                        <group string="Koneksi Odoo">
                            <field name="odoo_url" widget="url"/>
                            <field name="odoo_db"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_integra_school_tenant_search" model="ir.ui.view">
        <field name="name">integra.school.tenant.search</field>
        <field name="model">integra.school.tenant</field>
        <field name="arch" type="xml">
            <search string="Cari sekolah">
                <field name="school_code"/>
                <field name="school_name"/>
                <field name="odoo_db"/>
                <filter name="active" string="Aktif"
                        domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Diarsipkan"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Kelompokkan berdasarkan">
                    <filter name="group_active" string="Status"
                            context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_integra_school_tenant" model="ir.actions.act_window">
        <field name="name">Daftar sekolah</field>
        <field name="res_model">integra.school.tenant</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_integra_school_tenant_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_integra_school_admin_root"
              name="School Admin"
              sequence="35"
              groups="base.group_system"/>
    <menuitem id="menu_integra_school_tenant"
              name="Daftar sekolah"
              parent="menu_integra_school_admin_root"
              action="action_integra_school_tenant"
              sequence="10"
              groups="base.group_system"/>
</odoo>
