# For local development, Vite proxies /api/v1 to the FastAPI backend.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Leave this unset locally. For a separately hosted frontend, set the API base URL
# and add this frontend's HTTPS origin to the backend CORS_ALLOW_ORIGINS.
# VITE_API_BASE_URL=https://api.example.com/api/v1