# Optional: API port for the development web server.
SCHOOL_ADMIN_API_PORT=4174

# Required before starting the server. Set this in the terminal environment.
# Do not place this value in a client-side VITE_* variable.
# SCHOOL_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional server settings.
# SCHOOL_ADMIN_HOST=127.0.0.1
# SCHOOL_ADMIN_DATA_FILE=data/configuration.json
